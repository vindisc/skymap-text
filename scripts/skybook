#!/bin/bash
#
# skybook - CLI for SkyBook (the Skymap-Text fork of MiaoYan)
# https://github.com/vindisc/skymap-text
#

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

show_banner() {
    printf "${GREEN} _____ _          _  ____  ${NC}\n"
    printf "${GREEN}|_   _| | ___   _| |/ ___| ${NC}  ${BLUE}%s${NC}\n" "https://github.com/vindisc/skymap-text"
    printf "${GREEN}  | | | |/\\ \\ / / | |\\___ \\ ${NC}  ${GREEN}%s${NC}\n" "Markdown notes for macOS"
    printf "${GREEN}  | | | |  \\ V /| | |___) |${NC}\n"
    printf "${GREEN}  |_| |_|   \\_/ |_|_____/ ${NC}\n"
}

cmd_help() {
    show_banner
    echo
    printf "${BLUE}USAGE${NC}\n"
    printf "  skybook <command> [options]\n"
    echo
    printf "${BLUE}COMMANDS${NC}\n"
    printf "  ${GREEN}%-24s${NC} %s\n" "list [folder]" "List top-level folders, or markdown in folder"
    printf "  ${GREEN}%-24s${NC} %s\n" "search <query>" "Search notes in terminal"
    printf "  ${GREEN}%-24s${NC} %s\n" "open <title|path>" "Open note or folder"
    printf "  ${GREEN}%-24s${NC} %s\n" "cat <title|path>" "Print note content"
    printf "  ${GREEN}%-24s${NC} %s\n" "new <title> [text]" "Create new note"
    printf "  ${GREEN}%-24s${NC} %s\n" "help" "Show this help"
    echo
}

# Handle help before path detection
case "${1:-help}" in
    help|--help|-h) cmd_help; exit 0 ;;
esac

# Auto-detect notes path from app preferences
normalize_path() {
    local path="$1"

    [[ -z "$path" ]] && return

    # defaults may wrap string values with quotes when spaces are present
    path="${path#\"}"
    path="${path%\"}"

    # Handle file URLs from preferences
    if [[ "$path" == file://* ]]; then
        path="${path#file://}"
        path=$(printf '%b' "${path//%/\\x}")
    fi

    case "$path" in
        "~") path="$HOME" ;;
        "~/"*) path="$HOME/${path#~/}" ;;
    esac

    echo "$path"
}

read_pref_path() {
    local domain="$1"
    local key="$2"
    local raw_path
    local path

    raw_path=$(defaults read "$domain" "$key" 2>/dev/null || true)
    path=$(normalize_path "$raw_path")

    if [[ -n "$path" && -d "$path" ]]; then
        echo "$path"
    fi
}

detect_path() {
    local pref_path

    # The folder chosen in SkyBook's settings: the SwiftPM build keeps its
    # defaults in the bare local.skybook domain (no sandbox container).
    pref_path=$(read_pref_path "$HOME/Library/Preferences/local.skybook" "storageUrl")
    if [[ -n "$pref_path" ]]; then
        echo "$pref_path"
        return
    fi

    echo ""
}

NOTES_PATH="${SKYBOOK_PATH:-$(detect_path)}"

if [[ -z "$NOTES_PATH" || ! -d "$NOTES_PATH" ]]; then
    echo "Error: Notes directory not found." >&2
    echo "Set SKYBOOK_PATH or choose the library folder in SkyBook's settings." >&2
    exit 1
fi

# URL encode helper
urlencode() {
    # The text goes in as an argument, never into the Python source, so quotes,
    # backslashes and triple quotes in a title are just characters.
    python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

# The app: an installed SkyBook first, then the repo's fresh build, so a
# developer's `skybook open` does not raise the wrong (or no) app.
open_target() {
    local target="$1"
    open -a SkyBook "$target" 2>/dev/null \
        || open -a "$REPO_ROOT/.build/SkyBook.app" "$target" 2>/dev/null \
        || {
            echo "Error: SkyBook.app not found. Install it or run scripts/make_app.sh." >&2
            exit 1
        }
}

# Find note file by title (searches recursively, excludes Trash)
find_note() {
    local title="${1%.md}"
    find "$NOTES_PATH" -name "*.md" -not -path "*/Trash/*" | while read -r f; do
        basename="${f##*/}"
        name="${basename%.md}"
        [[ "$name" == "$title" ]] && echo "$f" && return
    done
}

resolve_note_path() {
    local arg="$1"
    local candidate
    local note

    # Explicit path from current directory or absolute path
    if [[ -f "$arg" ]]; then
        echo "$arg"
        return
    fi

    # Resolve relative paths against notes root
    if [[ "$arg" != /* ]]; then
        candidate="$NOTES_PATH/${arg#./}"
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return
        fi
        if [[ "$candidate" != *.md && -f "$candidate.md" ]]; then
            echo "$candidate.md"
            return
        fi
    elif [[ "$arg" != *.md && -f "$arg.md" ]]; then
        echo "$arg.md"
        return
    fi

    # Fallback to exact title match
    note=$(find_note "$arg")
    if [[ -n "$note" ]]; then
        echo "$note"
    fi
}

resolve_open_path() {
    local arg="$1"
    local candidate
    local note

    # Explicit path from current directory or absolute path
    if [[ -f "$arg" || -d "$arg" ]]; then
        echo "$arg"
        return
    fi

    # Resolve relative paths against notes root
    if [[ "$arg" != /* ]]; then
        candidate="$NOTES_PATH/${arg#./}"
        if [[ -f "$candidate" || -d "$candidate" ]]; then
            echo "$candidate"
            return
        fi
        if [[ "$candidate" != *.md && -f "$candidate.md" ]]; then
            echo "$candidate.md"
            return
        fi
    elif [[ "$arg" != *.md && -f "$arg.md" ]]; then
        echo "$arg.md"
        return
    fi

    # Fallback to exact title match
    note=$(find_note "$arg")
    if [[ -n "$note" ]]; then
        echo "$note"
    fi
}

# Commands
cmd_list() {
    local folder="$1"
    local search_path="$NOTES_PATH"
    local rel_path
    local has_root_notes=0

    if [[ -n "$folder" ]]; then
        search_path="$NOTES_PATH/${folder%/}"
        if [[ ! -d "$search_path" ]]; then
            echo "Folder not found: $folder" >&2
            exit 1
        fi

        find "$search_path" -type f -name "*.md" -not -path "*/Trash/*" | while read -r f; do
            rel_path="${f#$search_path/}"
            [[ "$rel_path" == */* ]] && continue
            # Keep output relative to notes root
            echo "${f#$NOTES_PATH/}"
        done | sort
        return
    fi

    find "$search_path" -mindepth 1 -maxdepth 1 -type d -not -name "Trash" -not -name ".*" | while read -r d; do
        # Only show top-level folders that actually contain markdown notes.
        if find "$d" -type f -name "*.md" -not -path "*/Trash/*" -print -quit | grep -q .; then
            echo "${d#$NOTES_PATH/}"
        fi
    done | sort

    if find "$search_path" -maxdepth 1 -type f -name "*.md" -print -quit | grep -q .; then
        has_root_notes=1
    fi

    if [[ "$has_root_notes" -eq 1 ]]; then
        echo "Tip: root notes are hidden in default list. Run 'skybook list .' to show them." >&2
    fi
}

cmd_search() {
    local query="$1"
    local tmp_file
    [[ -z "$query" ]] && echo "Usage: skybook search <query>" >&2 && exit 1

    tmp_file=$(mktemp)

    if command -v rg >/dev/null 2>&1; then
        rg -n --no-heading --color never -F --glob "*.md" --glob "!**/Trash/**" -- "$query" "$NOTES_PATH" >"$tmp_file" || true
    else
        find "$NOTES_PATH" -type f -name "*.md" -not -path "*/Trash/*" -exec grep -nH -- "$query" {} + >"$tmp_file" 2>/dev/null || true
    fi

    if [[ ! -s "$tmp_file" ]]; then
        rm -f "$tmp_file"
        echo "No matches found: $query" >&2
        exit 1
    fi

    while IFS= read -r line; do
        echo "${line#$NOTES_PATH/}"
    done <"$tmp_file"

    rm -f "$tmp_file"
}

cmd_open() {
    local arg="$1"
    local file
    [[ -z "$arg" ]] && echo "Usage: skybook open <title|path>" >&2 && exit 1

    # Prefer opening a resolved file or folder path to enter single mode
    file=$(resolve_open_path "$arg")
    if [[ -n "$file" ]]; then
        open_target "$file"
        return
    fi

    # Fallback to title route (strip optional .md suffix)
    open "skybook://goto/$(urlencode "${arg%.md}")"
}

cmd_new() {
    local title="$1"
    local text="${2:-}"
    [[ -z "$title" ]] && echo "Usage: skybook new <title> [text]" >&2 && exit 1

    local url="skybook://new/?title=$(urlencode "$title")"
    [[ -n "$text" ]] && url="$url&txt=$(urlencode "$text")"
    open "$url"
}

cmd_cat() {
    local arg="$1"
    local file
    [[ -z "$arg" ]] && echo "Usage: skybook cat <title|path>" >&2 && exit 1

    file=$(resolve_note_path "$arg")

    if [[ -z "$file" ]]; then
        echo "Note not found: $arg" >&2
        exit 1
    fi

    cat "$file"
}

# Main
case "$1" in
    list)    cmd_list "$2" ;;
    search)  cmd_search "$2" ;;
    open)    cmd_open "$2" ;;
    new)     cmd_new "$2" "$3" ;;
    cat)     cmd_cat "$2" ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run 'skybook help' for usage." >&2
        exit 1
        ;;
esac
